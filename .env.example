# PocketBase server (binary) version — the single source of truth. The setup
# script and Docker/CI builds all read this value; bump it here to upgrade.
POCKETBASE_VERSION=0.39.2

# Webapp client — base URL the browser uses to reach the PocketBase API.
# In Docker (single image, nginx proxy on :80) this is the same origin: leave blank
# or set to /api. For local dev, point at the standalone PocketBase port.
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090

# PocketBase superuser / admin auth. Two uses:
#   1. Migration tooling (yarn db:migrate / db:status) — auth to push generated
#      migrations into a running PocketBase instance (POCKETBASE_URL).
#   2. Docker deploys — when both EMAIL and PASSWORD are passed to the container,
#      the entrypoint auto-creates this superuser on boot (idempotent upsert).
#      Leave them unset to keep PocketBase's default: a one-time setup URL is
#      printed to the logs on first boot.
POCKETBASE_URL=http://localhost:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me

NODE_ENV=development
