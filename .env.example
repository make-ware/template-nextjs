# PocketBase server (binary) version — the single source of truth. The setup
# script and Docker/CI builds all read this value; bump it here to upgrade.
POCKETBASE_VERSION=0.39.9

# Webapp client — base URL the browser uses to reach the PocketBase API.
#
# BUILD-TIME ONLY. Next inlines every NEXT_PUBLIC_* variable into the browser
# bundle during `next build`, so setting this in a container's runtime env does
# nothing for the client — it only changes on a rebuild. In Docker (single
# image, nginx proxy on :80) the images bake "/" so everything is same-origin;
# for local dev, point at the standalone PocketBase port.
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090

# RUNTIME browser-facing PocketBase URL. Deliberately NOT NEXT_PUBLIC_-prefixed,
# so Next never inlines it: the Next server reads it per request and injects it
# into the page, which retargets an already-built image without a rebuild.
#
# Leave it empty for same-origin deployments (nginx proxies /api/ and /_/) —
# unset means "behave exactly as before". Set it when PocketBase lives on its
# own hostname, e.g. PUBLIC_POCKETBASE_URL=https://pb.example.com
#
# A split origin is a deployment change too: PocketBase must allow the webapp's
# origin via CORS, and the browser needs direct access to /api/realtime for the
# realtime SSE stream.
#
# Note that NEXT_PUBLIC_POCKETBASE_URL above is deliberately NOT honoured as a
# runtime fallback — it has always been inert at runtime, and honouring it now
# would silently break working same-origin deployments.
PUBLIC_POCKETBASE_URL=

# PocketBase superuser, for Docker deploys: when both EMAIL and PASSWORD are
# passed to the container, the entrypoint auto-creates this superuser on boot
# (idempotent upsert). Leave them unset to keep PocketBase's default — a one-time
# setup URL is printed to the logs on first boot.
#
# The migration scripts (yarn db:status / db:generate / db:verify) need none of
# this: they read the schemas, pocketbase/pb_migrations, and pocketbase/pb_data
# from disk rather than authenticating against a running server.
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me

NODE_ENV=development
