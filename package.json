{
  "name": "template-ware",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "webapp",
    "pocketbase"
  ],
  "scripts": {
    "setup": "node scripts/setup-pocketbase.js",
    "dev": "concurrently \"yarn workspace @template-ware/webapp dev\" \"yarn workspace @template-ware/pb dev\"",
    "build": "yarn workspaces foreach -A run build",
    "test": "yarn workspace @template-ware/webapp test",
    "test:watch": "concurrently  \"yarn workspace @template-ware/webapp test:watch\"",
    "lint:check": "yarn workspaces foreach -A run lint",
    "lint": "yarn workspaces foreach -A run lint:fix",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "format": "yarn workspaces foreach -A run format",
    "format:check": "yarn workspaces foreach -A run format:check",
    "clean": "yarn workspaces foreach -R run clean && rm -rf pocketbase/pocketbase",
    "typegen": "yarn workspace @template-ware/webapp typegen",
    "precommit": "yarn run lint && yarn run typecheck && yarn run format && yarn run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  }
}
